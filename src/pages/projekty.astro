---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projekty')).sort((a, b) => b.data.order - a.data.order);
const rendered = await Promise.all(
  projects.map(async (p) => ({ ...p, Content: (await render(p)).Content })),
);
---

<BaseLayout title="Projekty" description="Výběr projektů, na kterých jsem pracoval.">
  <section class="page-head">
    <span class="accent-bar"></span>
    <h1>Projekty</h1>
    <p class="muted">Výběr projektů, na kterých jsem v minulých pracích pracoval.</p>
  </section>

  {rendered.map(({ data, Content }) => (
    <article class="project">
      <p class="meta">{data.company} · {data.period}</p>
      <h2>{data.title}</h2>
      <p class="role">{data.role}</p>
      <p>{data.summary}</p>
      <div class="details"><Content /></div>
      <div>{data.tags.map((t) => <span class="tag">{t}</span>)}</div>
    </article>
  ))}
</BaseLayout>

<style>
  .page-head { padding-top: 3rem; }
  .project {
    border-left: 3px solid var(--accent);
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin: 2.5rem 0;
  }
  .project h2 { margin: 0.1rem 0 0.25rem; }
  .meta { margin: 0; font-size: 0.85rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .role { margin: 0; font-weight: 600; }
</style>
