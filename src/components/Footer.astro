---
import { SITE_TITLE, EMAIL, SOCIAL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <span>© {year} {SITE_TITLE}</span>
    <span class="links">
      <a href={`mailto:${EMAIL}`}>E-mail</a>
      {SOCIAL.map((s) => <a href={s.href} rel="me noopener" target="_blank">{s.label}</a>)}
      <a href="/rss.xml">RSS</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }
  .links { display: flex; flex-wrap: wrap; gap: 1rem; }
</style>
